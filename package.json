{
  "name": "hana-music-api",
  "version": "4.0.1",
  "private": false,
  "description": "Modern NCM API library for Bun & Node.js.",
  "keywords": [
    "bun",
    "esm",
    "music-api",
    "netease-cloud-music",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/nonhana/hana-music-api#readme",
  "bugs": {
    "url": "https://github.com/nonhana/hana-music-api/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonhana/hana-music-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./watchman": {
      "types": "./dist/watchman.d.ts",
      "default": "./dist/watchman.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsdown --config tsdown.browser.config.ts",
    "build:check": "bun run build && publint --strict && attw --pack . --profile esm-only",
    "changeset": "changeset",
    "dev": "bun --watch src/app/cli.ts",
    "docs:build": "vitepress build website",
    "docs:dev": "vitepress dev website",
    "docs:preview": "vitepress preview website",
    "fixtures:record": "bun scripts/record-fixtures.mts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "release": "changeset publish",
    "release:checked": "bun scripts/release-preflight.mts && bun run release",
    "schema:audit": "bun scripts/schema-audit.mts",
    "spell": "cspell --no-progress . .changeset",
    "start": "bun src/app/cli.ts",
    "start:prod": "NODE_ENV=production bun src/app/cli.ts",
    "test": "bun scripts/test.mts local",
    "test:live": "bun scripts/test.mts live",
    "test:load:smoke": "bun scripts/test.mts smoke && bun scripts/load-test.mts",
    "test:load:soak": "bun scripts/load-test.mts --soak",
    "test:sdk-contract": "bun scripts/test.mts sdk",
    "test:watchman": "bun scripts/test.mts watchman",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/browser/tsconfig.json",
    "types:modules:check": "bun scripts/gen-module-types.mts --check",
    "types:modules:generate": "bun scripts/gen-module-types.mts",
    "verify": "bun run types:modules:check && bun run schema:audit check && bun run build && bun run test && bun run typecheck && bun run lint && bun run spell && bun run fmt:check && bun run docs:build",
    "verify:fixtures": "bun run schema:audit check && bun run schema:audit recordings --recordings tests/fixtures/netease",
    "verify:sdk": "bun run types:modules:check && bun run build:check && bun run test:sdk-contract && bun run typecheck && bun run lint && bun run spell && bun run fmt:check && bun run docs:build",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "effect": "^4.1.2",
    "hono": "^4.13.16",
    "music-metadata": "^12.3.4",
    "qrcode": "^1.5.4",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "^0.67.1",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "cspell": "^10.4.0",
    "mermaid": "^12.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "1.65.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
