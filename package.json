{
  "name": "hana-music-api",
  "version": "1.2.1",
  "private": false,
  "description": "Modern NCM API library for Bun & Node.js.",
  "keywords": [
    "bun",
    "esm",
    "music-api",
    "netease-cloud-music",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/nonhana/hana-music-api#readme",
  "bugs": {
    "url": "https://github.com/nonhana/hana-music-api/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonhana/hana-music-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "build:check": "bun run build && publint --strict && attw --pack . --profile esm-only",
    "changeset": "changeset",
    "dev": "bun --watch src/app/cli.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "release": "changeset publish",
    "spell": "cspell --no-progress .",
    "start": "bun src/app/cli.ts",
    "start:prod": "NODE_ENV=production bun src/app/cli.ts",
    "test": "bun test tests/unit tests/contract tests/integration",
    "test:live": "bun test tests/live",
    "test:load:smoke": "bun test tests/load tests/integration/server-traffic.test.ts tests/unit/effect-request.test.ts tests/contract/module-runtime.test.ts && bun scripts/load-test.mts",
    "test:load:soak": "bun scripts/load-test.mts --soak",
    "test:sdk-contract": "bun test tests/contract/sdk-release-contract.test.ts",
    "typecheck": "tsc --noEmit",
    "types:modules:check": "bun scripts/gen-module-types.mts --check",
    "types:modules:generate": "bun scripts/gen-module-types.mts",
    "verify": "bun run types:modules:check && bun run build && bun test tests/unit tests/contract tests/integration && bun run typecheck && bun run lint && bun run spell && bun run fmt:check && bun run docs:build",
    "verify:sdk": "bun run types:modules:check && bun run build:check && bun test tests/contract/sdk-release-contract.test.ts tests/contract/module-api.test.ts tests/contract/module-discovery-alignment.test.ts && bun run typecheck && bun run lint && bun run spell && bun run fmt:check && bun run docs:build",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "effect": "^4.0.0",
    "hono": "^4.13.12",
    "music-metadata": "^11.16.1",
    "qrcode": "^1.5.4",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "^0.48.0",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "cspell": "^10.3.6",
    "mermaid": "^12.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "packageManager": "bun@1.4.2"
}
