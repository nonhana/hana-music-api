{
  "globs": ["docs/**/*.md"],
  "ignores": ["docs/.vitepress/cache/**", "docs/.vitepress/dist/**"],
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "heading_line_length": 120,
      "code_block_line_length": 120,
      "code_blocks": false,
      "tables": false,
    },
    "MD025": {
      "front_matter_title": "",
    },
    "MD033": {
      "table_allowed_elements": ["br"],
    },
    "MD060": false,
  },
}
